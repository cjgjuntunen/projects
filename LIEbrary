<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liebrary Game</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background: #2a1b3d;
            color: white;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }
        .hidden { display: none; }
        button {
            background: #ffcc00;
            border: none;
            padding: 10px 20px;
            margin: 5px;
            border-radius: 5px;
            cursor: pointer;
        }
        input {
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
            border: none;
        }
        .player-list {
            margin: 20px 0;
            padding: 10px;
            background: rgba(255,255,255,0.1);
        }
        .line-option {
            background: rgba(255,255,255,0.1);
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Liebrary</h1>

        <!-- Join Screen -->
        <div id="joinScreen">
            <input type="text" id="nameInput" placeholder="Your Name">
            <div>
                <button onclick="createGame()">Create Game</button>
                <button onclick="showJoinInput()">Join Game</button>
            </div>
            <div id="joinGameInput" class="hidden">
                <input type="text" id="roomInput" placeholder="Room Code">
                <button onclick="joinGame()">Join</button>
            </div>
        </div>

        <!-- Lobby -->
        <div id="lobbyScreen" class="hidden">
            <h2>Game Lobby</h2>
            <div id="roomCode"></div>
            <div id="playerList" class="player-list"></div>
            <div id="hostControls" class="hidden">
                <button onclick="startGame()">Start Game</button>
            </div>
        </div>

        <!-- Game -->
        <div id="gameScreen" class="hidden">
            <h2 id="bookTitle"></h2>
            <div id="submitSection" class="hidden">
                <input type="text" id="lineInput" placeholder="Write your first line">
                <button onclick="submitLine()">Submit</button>
            </div>
            <div id="voteSection" class="hidden"></div>
            <div id="resultsSection" class="hidden">
                <h3>Results</h3>
                <div id="scoresList"></div>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        let gameState = {
            roomCode: null,
            isHost: false,
            playerName: '',
            phase: 'join'
        };

        // UI Elements
        const screens = {
            join: document.getElementById('joinScreen'),
            lobby: document.getElementById('lobbyScreen'),
            game: document.getElementById('gameScreen')
        };

        function showScreen(screenName) {
            Object.keys(screens).forEach(key => {
                screens[key].classList.toggle('hidden', key !== screenName);
            });
        }

        function createGame() {
            const name = document.getElementById('nameInput').value.trim();
            if (!name) return alert('Please enter your name');
            gameState.playerName = name;
            socket.emit('createGame', { playerName: name });
        }

        function showJoinInput() {
            document.getElementById('joinGameInput').classList.remove('hidden');
        }

        function joinGame() {
            const name = document.getElementById('nameInput').value.trim();
            const roomCode = document.getElementById('roomInput').value.trim();
            if (!name || !roomCode) return alert('Please enter both name and room code');
            gameState.playerName = name;
            socket.emit('joinGame', { playerName: name, roomCode });
        }

        function startGame() {
            if (gameState.isHost) {
                socket.emit('startGame', { roomCode: gameState.roomCode });
            }
        }

        function submitLine() {
            const line = document.getElementById('lineInput').value.trim();
            if (!line) return alert('Please enter a line');
            socket.emit('submitLine', { 
                roomCode: gameState.roomCode, 
                line 
            });
            document.getElementById('submitSection').classList.add('hidden');
        }

        function vote(line) {
            socket.emit('vote', { 
                roomCode: gameState.roomCode, 
                line 
            });
            document.getElementById('voteSection').classList.add('hidden');
        }

        // Socket Events
        socket.on('gameCreated', (data) => {
            gameState.roomCode = data.roomCode;
            gameState.isHost = true;
            document.getElementById('roomCode').textContent = `Room Code: ${data.roomCode}`;
            showScreen('lobby');
            document.getElementById('hostControls').classList.remove('hidden');
        });

        socket.on('joinedGame', (data) => {
            gameState.roomCode = data.roomCode;
            showScreen('lobby');
            updatePlayerList(data.players);
        });

        socket.on('updateLobby', (data) => {
            updatePlayerList(data.players);
        });

        socket.on('gameStarted', (data) => {
            showScreen('game');
            document.getElementById('bookTitle').textContent = data.title;
            document.getElementById('submitSection').classList.remove('hidden');
        });

        socket.on('votingPhase', (data) => {
            document.getElementById('submitSection').classList.add('hidden');
            const voteSection = document.getElementById('voteSection');
            voteSection.classList.remove('hidden');
            voteSection.innerHTML = data.lines.map(line => 
                `<div class="line-option" onclick="vote('${line}')">${line}</div>`
            ).join('');
        });

        socket.on('gameResults', (data) => {
            const resultsSection = document.getElementById('resultsSection');
            resultsSection.classList.remove('hidden');
            document.getElementById('scoresList').innerHTML = data.scores.map(score => 
                `<div>${score.name}: ${score.points}</div>`
            ).join('');
        });

        socket.on('error', (error) => {
            alert(error.message);
        });

        function updatePlayerList(players) {
            document.getElementById('playerList').innerHTML = players.map(player => 
                `<div>${player.name}${player.isHost ? ' (Host)' : ''}</div>`
            ).join('');
        }
    </script>
</body>
</html>
const express = require('express');
const app = express();
const server = require('http').createServer(app);
const io = require('socket.io')(server);
const port = process.env.PORT || 3000;

app.use(express.static(__dirname));

const games = new Map();

const GAME_PHASES = {
    LOBBY: 'lobby',
    SUBMIT: 'submit',
    VOTE: 'vote',
    RESULTS: 'results'
};

const SAMPLE_TITLES = [
    "The Last Sunset",
    "Whispers in the Dark",
    "The Silent Garden",
    "Echoes of Tomorrow",
    "The Forgotten Door"
];

io.on('connection', (socket) => {
    socket.on('createGame', ({ playerName }) => {
        const roomCode = Math.random().toString(36).substring(2, 6).toUpperCase();
        games.set(roomCode, {
            players: [{ id: socket.id, name: playerName, isHost: true, score: 0 }],
            phase: GAME_PHASES.LOBBY,
            submissions: [],
            votes: [],
            title: '',
            roomCode
        });
        
        socket.join(roomCode);
        socket.emit('gameCreated', { roomCode });
    });

    socket.on('joinGame', ({ playerName, roomCode }) => {
        const game = games.get(roomCode);
        if (!game) {
            return socket.emit('error', { message: 'Game not found' });
        }
        
        game.players.push({ id: socket.id, name: playerName, isHost: false, score: 0 });
        socket.join(roomCode);
        
        io.to(roomCode).emit('updateLobby', { players: game.players });
        socket.emit('joinedGame', { roomCode, players: game.players });
    });

    socket.on('startGame', ({ roomCode }) => {
        const game = games.get(roomCode);
        if (!game) return;
        
        const player = game.players.find(p => p.id === socket.id);
        if (!player?.isHost) return;

        game.phase = GAME_PHASES.SUBMIT;
        game.title = SAMPLE_TITLES[Math.floor(Math.random() * SAMPLE_TITLES.length)];
        
        io.to(roomCode).emit('gameStarted', { title: game.title });
    });

    socket.on('submitLine', ({ roomCode, line }) => {
        const game = games.get(roomCode);
        if (!game || game.phase !== GAME_PHASES.SUBMIT) return;

        game.submissions.push({ playerId: socket.id, line });

        if (game.submissions.length === game.players.length) {
            game.phase = GAME_PHASES.VOTE;
            const lines = game.submissions.map(s => s.line);
            io.to(roomCode).emit('votingPhase', { lines });
        }
    });

    socket.on('vote', ({ roomCode, line }) => {
        const game = games.get(roomCode);
        if (!game || game.phase !== GAME_PHASES.VOTE) return;

        game.votes.push({ playerId: socket.id, line });

        if (game.votes.length === game.players.length) {
            calculateScores(game);
            io.to(roomCode).emit('gameResults', { 
                scores: game.players.map(p => ({ 
                    name: p.name, 
                    points: p.score 
                }))
            });
            
            resetRound(game);
        }
    });

    socket.on('disconnect', () => {
        for (const [roomCode, game] of games.entries()) {
            const playerIndex = game.players.findIndex(p => p.id === socket.id);
            if (playerIndex !== -1) {
                game.players.splice(playerIndex, 1);
                if (game.players.length === 0) {
                    games.delete(roomCode);
                } else {
                    if (game.players[0].isHost) {
                        game.players[0].isHost = true;
                    }
                    io.to(roomCode).emit('updateLobby', { players: game.players });
                }
                break;
            }
        }
    });
});

function calculateScores(game) {
    game.submissions.forEach(submission => {
        const votesReceived = game.votes.filter(v => v.line === submission.line).length;
        const submitter = game.players.find(p => p.id === submission.playerId);
        if (submitter) {
            submitter.score += votesReceived * 2;
        }
    });
}

function resetRound(game) {
    game.phase = GAME_PHASES.SUBMIT;
    game.submissions = [];
    game.votes = [];
    game.title = SAMPLE_TITLES[Math.floor(Math.random() * SAMPLE_TITLES.length)];
}

server.listen(port, '0.0.0.0', () => {
    console.log(`Server running on port ${port}`);
});
